# 忘忧酒肆 · 本地参考执行器的环境变量样例
#
# 复制成 env 文件后按需修改：
#   PowerShell: Get-Content dify/scripts/env.example | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { Set-Item -Path "Env:$($matches[1])" -Value $matches[2]" } }
#   bash:       set -a && . dify/scripts/env.example && set +a
#
# 这里只放占位值，不要把真实 Key 提交到仓库。

# PowerContext Server 地址（dify/scripts/dsl_runner.py 与 verify_cross_session.py 使用）
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
# Server 未开启鉴权时填任意非空占位符；开启了鉴权就填真实 Token
# （Server 端对应 POWERCONTEXT_SERVER_AUTH_TOKEN，两者填同一个值）
POWERCONTEXT_TOKEN=disabled

# 模型服务：OpenAI 兼容接口（国内 MiniMax 示例）
INNKEPER_LLM_BASE_URL=https://api.minimaxi.com/v1
INNKEPER_LLM_PROTOCOL=openai
INNKEPER_LLM_MODEL=MiniMax-M2.7
INNKEPER_LLM_API_KEY=replace-with-your-own-key
# 鉴权头风格：bearer 用 Authorization，x-api-key 用 x-api-key，both 都发
INNKEPER_LLM_AUTH_STYLE=bearer

# 模型服务：Anthropic 兼容接口（同一服务商换协议时用）
# INNKEPER_LLM_BASE_URL=https://api.minimaxi.com/anthropic
# INNKEPER_LLM_PROTOCOL=anthropic
# INNKEPER_LLM_AUTH_STYLE=x-api-key
