# StudyFlow 环境变量样例
#
# 复制为 qoder/.env 后按需修改：
#   PowerShell: Copy-Item qoder/.env.example qoder/.env
#   bash:       cp qoder/.env.example qoder/.env
#
# qoder/.env 已被 qoder/.gitignore 忽略，不会提交到仓库。
# 这里只放占位值，绝不要把真实密钥提交到仓库。

# --- PowerContext Server --------------------------------------------------
# StudyFlow 后端连接的 PowerContext 地址（不要写成本机 127.0.0.1:8000 以外的地址，
# PowerContext 的客户端拒绝把记忆内容通过明文 HTTP 发往非回环地址）。
STUDYFLOW_POWERCONTEXT_BASE_URL=http://127.0.0.1:8765

# PowerContext 的访问令牌。
# 服务端未开启鉴权（ACCESS_MODE=disabled）时填任意非空占位符即可；
# 开启鉴权（ACCESS_MODE=enforced）时必须与 POWERCONTEXT_SERVER_AUTH_TOKEN 一致。
STUDYFLOW_POWERCONTEXT_TOKEN=replace-with-your-powercontext-token

# 单次 PowerContext 请求超时（秒）。
STUDYFLOW_POWERCONTEXT_TIMEOUT=30

# 学习者 ID 与 PowerContext Scope 的绑定方式。
# 每个学习者 ID 在 PowerContext 中对应一个独立 Scope，这是用户隔离的基础。
STUDYFLOW_POWERCONTEXT_SCOPE_KIND=studyflow.learner_id
STUDYFLOW_POWERCONTEXT_INTEGRATION=studyflow
STUDYFLOW_POWERCONTEXT_BINDING_KIND=learner

# --- AI 模型服务 ----------------------------------------------------------
# 支持 OpenAI 兼容（/chat/completions）与 Anthropic 兼容（/messages）两种协议。
# 三项都必须填写，缺任意一项时 StudyFlow 不会伪造 AI 结果，
# 而是在界面上明确提示「AI 模型未配置」。
#
# Anthropic 兼容示例（MiniMax 官方）：
# STUDYFLOW_AI_API_BASE=https://api.minimaxi.com/anthropic
# STUDYFLOW_AI_MODEL=MiniMax-M2.7
# STUDYFLOW_AI_API_STYLE=anthropic
# STUDYFLOW_AI_API_KEY=replace-with-your-own-key
#
# OpenAI 兼容示例：
# STUDYFLOW_AI_API_BASE=https://api.openai.com/v1
# STUDYFLOW_AI_MODEL=gpt-4o-mini
# STUDYFLOW_AI_API_STYLE=openai
# STUDYFLOW_AI_API_KEY=replace-with-your-own-key

STUDYFLOW_AI_TIMEOUT=120
STUDYFLOW_AI_MAX_TOKENS=2048
STUDYFLOW_AI_TEMPERATURE=0.4

# --- 应用 ------------------------------------------------------------------
# 首次打开时默认使用的学习者 ID。
STUDYFLOW_DEFAULT_USER_ID=student_demo_001
