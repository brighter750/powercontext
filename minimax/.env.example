# sddctx 运行配置示例
#
# 复制为 .env 后按需修改：
#   cp minimax/.env.example minimax/.env
#
# 禁止提交真实凭据。本文件只提供占位值。

# --- 业务工程 ---
SDDCTX_PROJECT_ROOT=./minimax/business_project
SDDCTX_PROJECT_NAME=order-pricing
SDDCTX_WORK_DIR=./minimax/.sddctx-run

# --- 资料库（seekdb 与 OceanBase 二选一） ---
SDDCTX_DB_BACKEND=seekdb
SDDCTX_SEEKDB_PATH=./minimax/.sddctx-run/seekdb
# 使用 OceanBase 服务端时改为：
# SDDCTX_DB_BACKEND=oceanbase
# SDDCTX_OCEANBASE_DSN=mysql://root:replace-with-password@127.0.0.1:2881/test
SDDCTX_OCEANBASE_TABLE_PREFIX=sdd

# --- PowerContext（任务状态保存与复用） ---
SDDCTX_POWERCONTEXT_URL=http://127.0.0.1:8000
# Scope 由 `python -m sddctx state init-scope` 自动创建后填入
SDDCTX_POWERCONTEXT_SCOPE=replace-with-scope-id
# 仅在 PowerContext Server 开启鉴权时需要
SDDCTX_POWERCONTEXT_TOKEN=replace-with-server-token

# --- MiniMax ---
# 官方 Anthropic 兼容端点：https://api.minimaxi.com/anthropic
SDDCTX_MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
SDDCTX_MINIMAX_MODEL=MiniMax-M2.7
SDDCTX_MINIMAX_PROTOCOL=anthropic
SDDCTX_MINIMAX_MAX_TOKENS=8192
SDDCTX_MINIMAX_TIMEOUT=300
# 真实密钥请通过环境变量提供，不要写进本文件：
#   export SDDCTX_MINIMAX_API_KEY=sk-...
SDDCTX_MINIMAX_API_KEY=replace-with-minimax-api-key
